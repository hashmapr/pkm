// Phase 1 schema: auth + saved items + manual organization (tags/projects) + attachments.
// AIExtraction, Entity, RelatedItem, Embedding, ChatSession/ChatMessage are planned
// for Phases 2, 2, 4 and 5 respectively — see ARCHITECTURE.md — and are added as
// their own migrations when those phases start, not scaffolded empty here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SavedItemType {
  VOICE
  LINK
  ARTICLE
  YOUTUBE
  GITHUB
  SCREENSHOT
  PDF
  IMAGE
  NOTE
}

enum SavedItemStatus {
  NEW
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedItems SavedItem[]
  tags       Tag[]
  projects   Project[]

  @@map("users")
}

model SavedItem {
  id        String          @id @default(cuid())
  userId    String
  type      SavedItemType
  title     String
  source    String? // URL, file path, or null for freeform notes
  content   String? // raw or extracted text content
  summary   String?
  status    SavedItemStatus @default(NEW)
  metadata  Json? // type-specific raw fields (e.g. github stars, video duration)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        SavedItemTag[]
  projects    SavedItemProject[]
  attachments Attachment[]

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("saved_items")
}

model Attachment {
  id          String   @id @default(cuid())
  savedItemId String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItemTag[]

  @@unique([userId, name])
  @@map("tags")
}

model SavedItemTag {
  savedItemId String
  tagId       String

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedItemId, tagId])
  @@map("saved_item_tags")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItemProject[]

  @@unique([userId, name])
  @@map("projects")
}

model SavedItemProject {
  savedItemId String
  projectId   String

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([savedItemId, projectId])
  @@map("saved_item_projects")
}
