// Phase 1: auth + saved items + manual organization (tags/projects) + attachments.
// Phase 2: AI processing pipeline — ProcessingJob + extracted knowledge
// (ExtractedTask, ExtractedEntity, Decision, Question).
// Phase 3: voice capture — AudioAttachment feeds SavedItem.content, then reuses
// the Phase 2 pipeline unchanged.
// Phase 4: semantic search — Embedding (pgvector) indexed automatically when
// AI processing completes.
// Phase 5: AI assistant — Conversation/Message, retrieval-augmented chat over
// the same Embedding index.
// RelatedItem (Phase 2 follow-up, superseded by Phase 4 embedding similarity)
// remains unmigrated — see ARCHITECTURE.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum SavedItemType {
  VOICE
  LINK
  ARTICLE
  YOUTUBE
  GITHUB
  SCREENSHOT
  PDF
  IMAGE
  NOTE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EntityType {
  PERSON
  COMPANY
  TECHNOLOGY
  PROJECT
  BOOK
  URL
  CONCEPT
}

enum QuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

enum EmbeddingEntityType {
  SAVED_ITEM
  EXTRACTED_TASK
  DECISION
  QUESTION
  ENTITY
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedItems    SavedItem[]
  tags          Tag[]
  projects      Project[]
  conversations Conversation[]
  collections   Collection[]

  @@map("users")
}

model SavedItem {
  id              String           @id @default(cuid())
  userId          String
  type            SavedItemType
  title           String
  source          String? // URL, file path, or null for freeform notes
  content         String? // raw or extracted text content
  summary         String?
  keyPoints       String[] // AI-extracted key points (Phase 2)
  status          ProcessingStatus @default(PENDING)
  metadata        Json? // type-specific raw fields (e.g. github stars, video duration,
  // capture-provider extraction data — YouTube chapters, GitHub languages, webpage author, etc.)
  importanceScore Float? // Albo layer: AI-estimated 0-1, produced by the existing analyze() call
  saveReason      String? // Albo layer: AI-suggested "why this was saved," user-editable
  lastViewedAt    DateTime? // Albo layer: set when the item detail page is opened; powers "forgotten items"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        SavedItemTag[]
  projects    SavedItemProject[]
  attachments Attachment[]
  collections SavedItemCollection[]

  processingJobs    ProcessingJob[]
  extractedTasks    ExtractedTask[]
  extractedEntities ExtractedEntity[]
  decisions         Decision[]
  questions         Question[]
  audioAttachment   AudioAttachment?

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("saved_items")
}

model AudioAttachment {
  id                  String           @id @default(cuid())
  savedItemId         String           @unique
  fileUrl             String // storage key (StorageProvider reference); getUrl(fileUrl) computes a servable URL on demand
  duration            Int? // seconds
  transcript          String?
  transcriptionStatus ProcessingStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@map("audio_attachments")
}

// Polymorphic across SavedItem/ExtractedTask/Decision/Question/ExtractedEntity
// (entityType + entityId) rather than five separate embedding tables. No FK on
// entityId — it can't point at one table across five possible parents. All
// reads/writes go through raw SQL (see src/lib/services/embedding-index.ts);
// Prisma Client can't query an Unsupported column. The HNSW index on `vector`
// is added in a follow-up migration — Prisma's schema DSL can't express a
// vector index's operator class.
model Embedding {
  id         String                      @id @default(cuid())
  entityType EmbeddingEntityType
  entityId   String
  vector     Unsupported("vector(1536)")
  model      String
  createdAt  DateTime                    @default(now())

  @@unique([entityType, entityId])
  @@map("embeddings")
}

model ProcessingJob {
  id          String           @id @default(cuid())
  savedItemId String
  status      ProcessingStatus @default(PENDING)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId, createdAt])
  @@index([status])
  @@map("processing_jobs")
}

model ExtractedTask {
  id          String       @id @default(cuid())
  savedItemId String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  confidence  Float
  createdAt   DateTime     @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId])
  @@map("extracted_tasks")
}

model ExtractedEntity {
  id          String     @id @default(cuid())
  savedItemId String
  name        String
  type        EntityType
  confidence  Float
  createdAt   DateTime   @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId])
  @@index([name, type])
  @@map("extracted_entities")
}

model Decision {
  id          String   @id @default(cuid())
  savedItemId String
  statement   String
  reasoning   String?
  confidence  Float
  createdAt   DateTime @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId])
  @@map("decisions")
}

model Question {
  id          String         @id @default(cuid())
  savedItemId String
  question    String
  status      QuestionStatus @default(OPEN)
  createdAt   DateTime       @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@index([savedItemId])
  @@map("questions")
}

model Attachment {
  id          String   @id @default(cuid())
  savedItemId String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItemTag[]

  @@unique([userId, name])
  @@map("tags")
}

model SavedItemTag {
  savedItemId String
  tagId       String

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedItemId, tagId])
  @@map("saved_item_tags")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItemProject[]

  @@unique([userId, name])
  @@map("projects")
}

model SavedItemProject {
  savedItemId String
  projectId   String

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([savedItemId, projectId])
  @@map("saved_item_projects")
}

// Phase 5: AI assistant conversations. Not tied to SavedItem — a
// conversation can range across many saved items via retrieval, so it
// belongs to the user directly, like Tag/Project.
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  // Full structured response snapshot for ASSISTANT messages: cited
  // sources, related (uncited) items, confidence, suggested actions — one
  // JSON blob since they're produced together by one assistant turn and
  // read together by the UI. Null for USER messages.
  sourcesUsed    Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Albo-inspired layer: a lighter, more casual organizing layer than
// Project — no description requirement, an emoji "cover" instead of a
// photo upload, and a flag distinguishing user-created from AI-suggested
// collections. See ALBO_ANALYSIS.md / ALBO_INTEGRATION_PLAN.md.
model Collection {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  emoji         String?
  isAiSuggested Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItemCollection[]

  @@unique([userId, name])
  @@map("collections")
}

model SavedItemCollection {
  savedItemId  String
  collectionId String
  addedAt      DateTime @default(now())

  savedItem  SavedItem  @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([savedItemId, collectionId])
  @@map("saved_item_collections")
}
