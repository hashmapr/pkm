DATABASE_URL="postgresql://pkm:pkm@localhost:5432/pkm"
JWT_SECRET="replace-with-a-long-random-string"

# Phase 2: AI processing pipeline
ANTHROPIC_API_KEY=""

# Phase 3: voice capture
OPENAI_API_KEY=""
# STORAGE_LOCAL_DIR="uploads"  # optional, defaults to ./uploads

# Phase B (Sub-Phase B): GitHub capture provider — optional, raises the
# unauthenticated GitHub API rate limit and allows capturing private repos
# you have access to. Capture still works without it for public repos.
# GITHUB_TOKEN=""

# --- Local / self-hosted model backends (Ollama, NVIDIA NIM) ---
# Each capability (extraction, chat, embeddings) can be switched to any
# backend that speaks the OpenAI-compatible API independently of the others —
# leave unset to keep using Claude/OpenAI. See ARCHITECTURE.md for the
# embedding-dimension caveat before switching EMBEDDING_PROVIDER.
#
# AI_PROVIDER="openai-compatible"          # default: claude
# ASSISTANT_PROVIDER="openai-compatible"   # default: claude
# EMBEDDING_PROVIDER="openai-compatible"   # default: openai
#
# OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"  # Ollama's OpenAI-compat endpoint; or your NIM endpoint
# OPENAI_COMPATIBLE_API_KEY=""              # Ollama: leave unset; NIM: your NIM API key
# OPENAI_COMPATIBLE_MODEL="llama3.1"        # chat/extraction model name as your backend names it
# OPENAI_COMPATIBLE_EMBEDDING_MODEL="nomic-embed-text"
# OPENAI_COMPATIBLE_EMBEDDING_DIMENSIONS="768"  # must match the model's real output width
